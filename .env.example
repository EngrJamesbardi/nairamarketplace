# Copy to .env.local and fill in. Placeholders only — never commit real secrets.

# Public site URL (used for auth redirects, metadata and payment callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (local values are printed by `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payments for platform services (credits, subscriptions).
# "mock" = clearly labelled development mock. Real providers need accounts + credentials.
PAYMENTS_ENABLED_PROVIDERS=mock
# 16+ random characters. The placeholder below is rejected on purpose: replace it to use the mock locally.
MOCK_PAYMENT_WEBHOOK_SECRET=change-me-dev-only
# The mock is refused in production builds (`npm run build && npm start`) unless this is "true".
# Only for a private local test of the production build. NEVER set it on a public deployment.
# ALLOW_MOCK_PAYMENTS=true
# Paystack (not configured — see docs/EXTERNAL_SERVICES.md)
PAYSTACK_SECRET_KEY=
# Optional phone verification provider (not configured)
# Phone verification is NOT implemented yet; reserved for a future SMS provider.
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=

# "demo" only on the public demo site (demo.nairamarketplace.com): shows a Demo site banner and blocks search engines.
# Leave unset in production.
# NEXT_PUBLIC_SITE_MODE=demo

# Shared rate-limit store (Upstash Redis REST). Recommended on Vercel, where each instance has its own memory.
# Without these, limits are kept in memory per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local testing only: multiplies app-level rate limits. Leave unset in production.
# RATE_LIMIT_SCALE=50

# Secret for the scheduled maintenance endpoint (/api/cron/maintenance). 32+ random characters.
CRON_SECRET=
# Salt for hashing pseudonymous viewer keys used to de-duplicate sponsored impressions/clicks.
ANALYTICS_SALT=
